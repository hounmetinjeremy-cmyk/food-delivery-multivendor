{
  "name": "enatega-multivendor-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enatega-multivendor-db",
      "database_id": "18cc0b8a-addd-429c-bd0c-f6fc21480ff2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "center-storage"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["RealtimeHub"] }
  ]
}
