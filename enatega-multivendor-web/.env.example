# Enatega Multivendor Web - Environment Configuration
# Copy this file to .env.local for development or set env vars in your deployment platform

# Backend GraphQL endpoint (Render - required)
NEXT_PUBLIC_SERVER_URL=https://enatega-server.onrender.com/graphql

# Backend WebSocket endpoint (Render - required)
NEXT_PUBLIC_WS_SERVER_URL=wss://enatega-server.onrender.com/graphql

# Vendor mode: MULTI | SINGLE | TOGGLE
NEXT_PUBLIC_VENDOR_MODE=MULTI

# Single vendor URLs (only needed when NEXT_PUBLIC_VENDOR_MODE=SINGLE or TOGGLE)
# Defaults to the same Render backend; override if you run a separate single-vendor API.
NEXT_PUBLIC_SINGLE_VENDOR_SERVER_URL=https://enatega-server.onrender.com/graphql
NEXT_PUBLIC_SINGLE_VENDOR_WS_SERVER_URL=wss://enatega-server.onrender.com/graphql
NEXT_PUBLIC_SINGLE_VENDOR_REST_URL=https://enatega-server.onrender.com/
NEXT_PUBLIC_SINGLE_VENDOR_ENABLED=false

# Google Maps / Firebase (fill with your own keys)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
