# Enatega Multivendor Admin - Environment Configuration
# Copy this file to .env.local for development or set env vars in your deployment platform

# Backend GraphQL endpoint (required)
NEXT_PUBLIC_SERVER_URL=https://food-delivery-multivendor.hounmetinjeremy.workers.dev/graphql

# Backend WebSocket endpoint (required)
NEXT_PUBLIC_WS_SERVER_URL=wss://food-delivery-multivendor.hounmetinjeremy.workers.dev/graphql

# Google Maps / Firebase (fill with your own keys)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
